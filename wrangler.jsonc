{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "symposium-management-system",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "symposium-management-system",
      "database_id": "9bcfc86d-5215-4fa6-b48b-346a14eb141e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "symposium-management-system"
    }
  ],
  "vars": {
    "APP_NAME": "Symposium Management System"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "symposium-management-preview",
          "database_id": "4cd54fc2-bea7-47d1-825b-dce0ebd78f53",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "symposium-management-preview"
        }
      ],
      "vars": {
        "APP_NAME": "Symposium Management System · Preview"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "symposium-management-system",
          "database_id": "9bcfc86d-5215-4fa6-b48b-346a14eb141e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "symposium-management-system"
        }
      ],
      "vars": {
        "APP_NAME": "Symposium Management System"
      }
    }
  }
}
