---
export const prerender = false;
---
<!doctype html>
<html lang="id">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Sign in · Symposium Management System</title></head>
  <body>
    <main class="shell">
      <a href="/" class="back">← Back to schedule</a>
      <section class="panel">
        <p class="eyebrow">OPERATOR ACCESS</p><h1>Welcome back.</h1><p class="muted">Sign in to manage symposium sessions and presentation materials.</p>
        <form id="login-form">
          <label>Email address<input name="email" type="email" autocomplete="username" required /></label>
          <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
          <button type="submit">Sign in</button><p id="message" role="status"></p>
        </form>
      </section>
    </main>
    <script>
      const form = document.querySelector("#login-form");
      const message = document.querySelector("#message");
      form.addEventListener("submit", async (event) => {
        event.preventDefault(); message.textContent = "Signing in…";
        const data = Object.fromEntries(new FormData(form));
        try {
          const response = await fetch("/api/auth/login", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || "Unable to sign in.");
          location.href = "/workspace";
        } catch (error) { message.textContent = error.message; }
      });
    </script>
    <style>
      :root{color-scheme:dark;--bg:#0b1120;--panel:#131e30;--line:#27364d;--muted:#9aabc2;--text:#eef4fb;--accent:#53c7a5}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 0%,#163044 0,transparent 45%),var(--bg);color:var(--text);font:15px/1.6 system-ui,sans-serif}.shell{max-width:440px;margin:10vh auto;padding:24px}.back{font-size:12px;color:var(--muted);text-decoration:none}.panel{margin-top:22px;padding:30px;background:var(--panel);border:1px solid var(--line);border-radius:16px}.eyebrow{font-size:10px;color:var(--accent);letter-spacing:2px;font-weight:700}h1{font-size:32px;margin:8px 0}.muted{color:var(--muted);font-size:13px}form{margin-top:26px}label{display:grid;gap:7px;margin:15px 0;font-size:12px;color:var(--muted)}input{background:#0b1423;border:1px solid var(--line);border-radius:8px;padding:12px;color:var(--text);font:inherit}button{width:100%;padding:12px;border:0;border-radius:8px;background:var(--accent);color:#08251e;font-weight:750;font:inherit;cursor:pointer}#message{min-height:20px;color:#ffb4ae;font-size:12px}
    </style>
  </body>
</html>