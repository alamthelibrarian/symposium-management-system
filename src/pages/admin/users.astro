---
import { getSessionUser } from "../../lib/auth";
export const prerender = false;
const user = await getSessionUser(Astro.locals.runtime.env.DB, Astro.request);
if (!user) return Astro.redirect("/login");
if (user.role !== "administrator") return new Response("Forbidden", { status: 403 });
---
<!doctype html>
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b1120"/><title>User administration · Symposium</title></head>
<body>
<header><a class="brand" href="/">SMS<span>.</span></a><div class="identity"><b>User administration</b><small>Signed in as {user.display_name}</small></div><a class="back" href="/workspace">← Workspace</a></header>
<main>
  <div class="heading"><div><p class="eyebrow">SYSTEM ADMINISTRATION</p><h1>Manage users</h1><p class="muted">Create accounts, assign roles, and suspend access when necessary.</p></div><span class="secure">Administrator access</span></div>
  <section class="panel">
    <div class="section-head"><div><p class="eyebrow">NEW ACCOUNT</p><h2>Create user</h2></div></div>
    <form id="create-form">
      <div class="fields"><label>Full name<input name="display_name" required minlength="2" maxlength="180"/></label><label>Email address<input name="email" type="email" required maxlength="254"/></label><label>Password<input name="password" type="password" required minlength="12" autocomplete="new-password"/><small>At least 12 characters.</small></label><label>Role<select name="role"><option value="viewer">Viewer</option><option value="moderator">Moderator</option><option value="operator">Operator</option><option value="administrator">Administrator</option></select></label></div>
      <button class="primary" type="submit">Create account</button><p id="form-message" class="muted" role="status"></p>
    </form>
  </section>
  <section class="panel users-panel">
    <div class="section-head"><div><p class="eyebrow">ACCESS CONTROL</p><h2>Registered users</h2></div><button id="refresh">Refresh</button></div>
    <div id="users"><p class="muted">Loading accounts…</p></div>
  </section>
</main>
<script define:vars={{currentUserId:user.id}}>
const $=id=>document.getElementById(id);
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
async function api(url,options={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json",...(options.headers||{})}});if(r.status===204)return null;const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||"Request failed");return d}
async function load(){ $("users").innerHTML='<p class="muted">Loading accounts…</p>';try{const data=await api("/api/users");$("users").innerHTML=(data.users||[]).map(u=>'<article class="user-row" data-id="'+esc(u.id)+'"><div class="avatar">'+esc((u.display_name||"?").trim().charAt(0).toUpperCase())+'</div><div class="user-info"><b>'+esc(u.display_name)+'</b><small>'+esc(u.email)+'</small><span class="status '+(u.is_active?'active':'inactive')+'">'+(u.is_active?'Active':'Suspended')+'</span></div><label class="role-control">Role<select data-role="'+esc(u.id)+'" '+(u.id===currentUserId?'disabled':'')+'><option value="viewer" '+(u.role==="viewer"?"selected":"")+'>Viewer</option><option value="moderator" '+(u.role==="moderator"?"selected":"")+'>Moderator</option><option value="operator" '+(u.role==="operator"?"selected":"")+'>Operator</option><option value="administrator" '+(u.role==="administrator"?"selected":"")+'>Administrator</option></select></label><button data-toggle="'+esc(u.id)+'" data-active="'+(u.is_active?1:0)+'" '+(u.id===currentUserId?'disabled':'')+' class="'+(u.is_active?'danger':'')+'">'+(u.is_active?'Suspend':'Activate')+'</button></article>').join("")||'<p class="muted">No user accounts found.</p>'}catch(e){$("users").innerHTML='<p class="error">'+esc(e.message)+'</p>'}}
$("create-form").addEventListener("submit",async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;$("form-message").textContent="Creating account…";const body=Object.fromEntries(new FormData(e.currentTarget));try{await api("/api/users",{method:"POST",body:JSON.stringify(body)});e.currentTarget.reset();$("form-message").textContent="Account created successfully.";await load()}catch(err){$("form-message").textContent=err.message}finally{button.disabled=false}});
$("users").addEventListener("change",async e=>{const select=e.target.closest("select[data-role]");if(!select)return;try{await api("/api/users/"+encodeURIComponent(select.dataset.role),{method:"PATCH",body:JSON.stringify({role:select.value})});await load()}catch(err){alert(err.message);await load()}});
$("users").addEventListener("click",async e=>{const button=e.target.closest("button[data-toggle]");if(!button)return;const active=button.dataset.active!=="1";if(!confirm((active?"Activate":"Suspend")+" this account?"))return;button.disabled=true;try{await api("/api/users/"+encodeURIComponent(button.dataset.toggle),{method:"PATCH",body:JSON.stringify({is_active:active})});await load()}catch(err){alert(err.message);button.disabled=false}});
$("refresh").onclick=load;
await load();
</script>
<style>
:root{color-scheme:dark;--bg:#0b1120;--panel:#131e30;--line:#27364d;--muted:#9aabc2;--text:#eef4fb;--accent:#53c7a5}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,sans-serif}header{display:flex;align-items:center;gap:14px;padding:17px max(22px,calc((100% - 1050px)/2));border-bottom:1px solid #ffffff12}.brand{font-size:20px;font-weight:900;color:var(--accent);text-decoration:none}.brand span{color:white}.identity{flex:1}.identity b,.identity small{display:block}.identity small{font-size:11px;color:var(--muted)}.back{color:var(--accent);font-size:12px;text-decoration:none}main{max-width:1050px;margin:38px auto 70px;padding:0 22px}.heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:1.7px;margin:0 0 5px}.heading h1{font-size:30px;margin:0}.muted{color:var(--muted)}.heading .muted{font-size:12px}.secure{font-size:11px;color:var(--accent);border:1px solid var(--line);padding:7px 10px;border-radius:20px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:17px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.section-head h2{font-size:16px;margin:0}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fields label{display:grid;gap:6px;color:var(--muted);font-size:11px}.fields input,.fields select,.role-control select{width:100%;background:#0b1423;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:10px;font:inherit}.fields small{font-size:10px}.primary,button{background:#1b2940;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:9px 12px;cursor:pointer;font:inherit;font-size:11px}.primary{background:var(--accent);border-color:var(--accent);color:#08251e;font-weight:800;margin-top:14px}button:disabled{opacity:.45;cursor:not-allowed}#form-message{font-size:11px;min-height:17px}.user-row{display:grid;grid-template-columns:38px minmax(0,1fr) 160px auto;align-items:center;gap:12px;padding:13px 0;border-top:1px solid var(--line)}.avatar{width:34px;height:34px;border-radius:10px;background:#20334a;color:var(--accent);display:grid;place-items:center;font-weight:800}.user-info b,.user-info small{display:block}.user-info small{font-size:11px;color:var(--muted)}.status{display:inline-block;font-size:9px;text-transform:uppercase;letter-spacing:1px;margin-top:4px}.status.active{color:var(--accent)}.status.inactive,.error,.danger{color:#ffaaa8}.role-control{display:grid;gap:4px;font-size:10px;color:var(--muted)}@media(max-width:650px){.heading{align-items:start;flex-direction:column}.fields{grid-template-columns:1fr}.user-row{grid-template-columns:34px minmax(0,1fr) auto}.role-control{grid-column:2;grid-row:2}.user-row>button{grid-column:3;grid-row:1/3}.panel{padding:15px}}
</style>
</body></html>