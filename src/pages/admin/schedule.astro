---
import { getSessionUser } from "../../lib/auth";
export const prerender = false;
const user = await getSessionUser(Astro.locals.runtime.env.DB, Astro.request);
if (!user) return Astro.redirect("/login");
if (!["administrator","operator"].includes(user.role)) return new Response("Forbidden", { status: 403 });
const isAdmin = user.role === "administrator";
---
<!doctype html>
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b1120"/><title>Schedule administration · Symposium</title></head>
<body>
<header><a class="brand" href="/">SMS<span>.</span></a><div class="identity"><b>Schedule administration</b><small>{user.display_name} · {user.role}</small></div><a class="back" href="/workspace">← Workspace</a></header>
<main>
 <div class="heading"><div><p class="eyebrow">EVENT CONFIGURATION</p><h1>Events & sessions</h1><p class="muted">Manage symposium dates, session blocks, and their running times.</p></div></div>
 <section class="panel">
  <div class="section-head"><div><p class="eyebrow">CREATE EVENT</p><h2>Add event date</h2></div></div>
  <form id="event-form"><div class="fields"><label>Event title<input name="title" value="Symposium" required maxlength="180"/></label><label>Date<input name="event_date" type="date" required/></label><label>Start time<input name="start_time" type="time" value="13:00" required/></label><label>End time<input name="end_time" type="time" value="15:30" required/></label></div><button class="primary" type="submit">Create event</button><p id="event-message" class="muted"></p></form>
 </section>
 <section class="panel">
  <div class="section-head"><div><p class="eyebrow">SCHEDULED DATES</p><h2>Event list</h2></div><button id="refresh">Refresh</button></div>
  <div id="events"><p class="muted">Loading events…</p></div>
 </section>
 <section class="panel">
  <div class="section-head"><div><p class="eyebrow">SESSION BLOCKS</p><h2>Sessions for selected event</h2></div><span id="selected-label" class="muted">Select an event</span></div>
  <form id="session-form"><div class="fields"><label>Session title<input name="title" placeholder="e.g. Main session" required maxlength="180"/></label><label>Sort order<input name="sort_order" type="number" min="0" value="1" required/></label><label>Start time<input name="start_time" type="time"/></label><label>End time<input name="end_time" type="time"/></label></div><button class="primary" type="submit">Add session</button><p id="session-message" class="muted"></p></form>
  <div id="sessions" class="session-list"><p class="muted">Select an event first.</p></div>
 </section>
</main>
<script define:vars={{isAdmin}}>
const $=id=>document.getElementById(id);let events=[],sessions=[],selected=null;
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
async function api(url,options={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json",...(options.headers||{})}});if(r.status===204)return null;const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||"Request failed");return d}
async function loadEvents(){const data=await api("/api/events");events=data.events||[];$("events").innerHTML=events.map(e=>'<article class="event-row '+(e.id===selected?'selected':'')+'"><button class="event-select" data-select="'+esc(e.id)+'"><b>'+esc(e.title)+'</b><small>'+esc(e.event_date)+' · '+esc(e.start_time)+'–'+esc(e.end_time)+' · '+esc(e.status)+'</small></button><div class="actions"><button data-edit="'+esc(e.id)+'">Edit</button>'+(isAdmin?'<button class="danger" data-delete="'+esc(e.id)+'">Delete</button>':'')+'</div></article>').join("")||'<p class="muted">No events yet.</p>';if(!selected&&events.length)selected=events[0].id;if(selected&&!events.some(e=>e.id===selected))selected=events[0]?.id||null;await loadSessions()}
async function loadSessions(){if(!selected){$("sessions").innerHTML='<p class="muted">Select an event first.</p>';return}const event=events.find(e=>e.id===selected);$("selected-label").textContent=event?event.event_date:"";const data=await api("/api/sessions?event_id="+encodeURIComponent(selected));sessions=data.sessions||[];$("sessions").innerHTML=sessions.map(s=>'<article class="session-row"><div><b>'+esc(s.title)+'</b><small>Order '+esc(s.sort_order)+' · '+esc(s.start_time||"No start time")+' – '+esc(s.end_time||"No end time")+'</small></div><div class="actions"><button data-session-edit="'+esc(s.id)+'">Edit</button>'+(isAdmin?'<button data-session-delete="'+esc(s.id)+'" class="danger">Delete</button>':'')+'</div></article>').join("")||'<p class="muted">No sessions configured.</p>';const order=$("session-form").elements.sort_order;order.value=String(sessions.length+1)}
$("event-form").addEventListener("submit",async e=>{e.preventDefault();const b=e.submitter;b.disabled=true;const data=Object.fromEntries(new FormData(e.currentTarget));try{const created=await api("/api/events",{method:"POST",body:JSON.stringify(data)});selected=created.id;e.currentTarget.reset();$("event-message").textContent="Event created.";await loadEvents()}catch(err){$("event-message").textContent=err.message}finally{b.disabled=false}});
$("session-form").addEventListener("submit",async e=>{e.preventDefault();if(!selected){$("session-message").textContent="Select an event first.";return}const b=e.submitter;b.disabled=true;const data=Object.fromEntries(new FormData(e.currentTarget));data.event_id=selected;try{await api("/api/sessions",{method:"POST",body:JSON.stringify(data)});$("session-message").textContent="Session added.";e.currentTarget.elements.title.value="";await loadSessions()}catch(err){$("session-message").textContent=err.message}finally{b.disabled=false}});
$("events").addEventListener("click",async e=>{const b=e.target.closest("button");if(!b)return;if(b.dataset.select){selected=b.dataset.select;await loadEvents();return}if(b.dataset.edit){const event=events.find(x=>x.id===b.dataset.edit);const title=prompt("Event title:",event.title);if(title===null)return;const event_date=prompt("Date (YYYY-MM-DD):",event.event_date);if(event_date===null)return;const start_time=prompt("Start time (HH:MM):",event.start_time);if(start_time===null)return;const end_time=prompt("End time (HH:MM):",event.end_time);if(end_time===null)return;const status=prompt("Status: draft, published, completed",event.status);if(status===null)return;try{await api("/api/events/"+encodeURIComponent(event.id),{method:"PATCH",body:JSON.stringify({...event,title,event_date,start_time,end_time,status})});await loadEvents()}catch(err){alert(err.message)}return}if(b.dataset.delete){if(!confirm("Delete this event and all its sessions, presenters, and associated materials? This cannot be undone."))return;try{await api("/api/events/"+encodeURIComponent(b.dataset.delete),{method:"DELETE"});selected=null;await loadEvents()}catch(err){alert(err.message)}}});
$("sessions").addEventListener("click",async e=>{const b=e.target.closest("button");if(!b)return;if(b.dataset.sessionEdit){const s=sessions.find(x=>x.id===b.dataset.sessionEdit);const title=prompt("Session title:",s.title);if(title===null)return;const sort_order=Number(prompt("Sort order:",s.sort_order));if(!Number.isInteger(sort_order)||sort_order<0)return;const start_time=prompt("Start time (HH:MM, optional):",s.start_time||"");if(start_time===null)return;const end_time=prompt("End time (HH:MM, optional):",s.end_time||"");if(end_time===null)return;try{await api("/api/sessions/"+encodeURIComponent(s.id),{method:"PATCH",body:JSON.stringify({title,sort_order,start_time,end_time})});await loadSessions()}catch(err){alert(err.message)}return}if(b.dataset.sessionDelete){if(!confirm("Delete this session and all its presenters and materials? This cannot be undone."))return;try{await api("/api/sessions/"+encodeURIComponent(b.dataset.sessionDelete),{method:"DELETE"});await loadSessions()}catch(err){alert(err.message)}}});
$("refresh").onclick=loadEvents;await loadEvents();
</script>
<style>
:root{color-scheme:dark;--bg:#0b1120;--panel:#131e30;--line:#27364d;--muted:#9aabc2;--text:#eef4fb;--accent:#53c7a5}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,sans-serif}header{display:flex;align-items:center;gap:14px;padding:17px max(22px,calc((100% - 1050px)/2));border-bottom:1px solid #ffffff12}.brand{font-size:20px;font-weight:900;color:var(--accent);text-decoration:none}.brand span{color:white}.identity{flex:1}.identity b,.identity small{display:block}.identity small{font-size:11px;color:var(--muted)}.back{font-size:12px;color:var(--accent);text-decoration:none}main{max-width:1050px;margin:38px auto 70px;padding:0 22px}.heading{margin-bottom:24px}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:1.7px;margin:0 0 5px}.heading h1{font-size:30px;margin:0}.muted{color:var(--muted);font-size:11px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:17px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.section-head h2{font-size:16px;margin:0}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fields label{display:grid;gap:5px;color:var(--muted);font-size:11px}.fields input{width:100%;background:#0b1423;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:10px;font:inherit}.primary,button{background:#1b2940;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px 11px;cursor:pointer;font:inherit;font-size:11px}.primary{background:var(--accent);border-color:var(--accent);color:#08251e;font-weight:800;margin-top:12px}.event-row,.session-row{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding:12px 0}.event-select{border:0;background:none;text-align:left;flex:1}.event-select b,.event-select small,.session-row b,.session-row small{display:block}.event-select small,.session-row small{font-size:10px;color:var(--muted);margin-top:3px}.event-row.selected{border-left:2px solid var(--accent);padding-left:10px}.actions{display:flex;gap:6px}.actions button{font-size:10px}.danger{color:#ffaaa8}.session-list{margin-top:15px}.session-row>div:first-child{flex:1}@media(max-width:600px){main{margin-top:25px}.fields{grid-template-columns:1fr}.panel{padding:15px}.event-row,.session-row{align-items:flex-start}.actions{flex-direction:column}}
</style>
</body></html>