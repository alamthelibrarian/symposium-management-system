---
import { getSessionUser } from "../lib/auth";
export const prerender = false;
const user = await getSessionUser(Astro.locals.runtime.env.DB, Astro.request);
if (!user) return Astro.redirect("/login");
const canEdit = ["administrator", "operator"].includes(user.role);
const canModerate = ["administrator", "operator", "moderator"].includes(user.role);
---
<!doctype html>
<html lang="id">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#0b1120" /><title>Workspace · Symposium Management System</title></head>
<body>
<header class="topbar"><a class="brand" href="/">SMS<span>.</span></a><div class="identity"><strong>Symposium workspace</strong><small>{user.display_name} · {user.role}</small></div><button id="logout" class="quiet">Sign out</button></header>
<main>
  <div class="page-heading"><div><p class="eyebrow">SESSION OPERATIONS</p><h1>Control room</h1></div><div class="heading-actions"><span class="live"><i></i> Connected to workspace</span><a id="projector-link" class="projector-link" href="#" target="_blank" rel="noopener">Projector display ↗</a>{user.role === "administrator" && <a class="projector-link" href="/admin/users">User administration</a>}</div></div>
  <section class="toolbar panel"><label>Event date<select id="event-select"><option>Loading events…</option></select></label><label>Session<select id="session-select"><option>Select an event</option></select></label><span id="event-time" class="muted"></span></section>
  <div class="columns">
    <section class="panel sequence">
      <div class="section-head"><div><p class="eyebrow">PRESENTATION ORDER</p><h2>Presenter sequence</h2></div><span id="presenter-count" class="muted">0 presenters</span></div>
      <div id="presenter-list" class="presenter-list"><p class="muted">Loading schedule…</p></div>
      {canEdit && <form id="presenter-form" class="add-form">
        <h3>Add presenter</h3><div class="form-grid"><label>Presenter name<input name="display_name" required maxlength="180" /></label><label>Affiliation<input name="affiliation" maxlength="180" /></label><label class="wide">Presentation title<input name="presentation_title" required maxlength="300" /></label></div><button class="primary" type="submit">Add to sequence</button><p id="form-message" class="muted"></p>
      </form>}
    </section>
    <aside class="panel timer-panel">
      <div class="section-head"><div><p class="eyebrow">SESSION CONTROL</p><h2>Presentation timer</h2></div><span class="sync" id="sync-status">Syncing</span></div>
      <div class="timer-face"><div id="timer-phase" class="phase">OPENING</div><div id="timer-clock" class="clock">10:00</div><div class="progress"><span id="timer-progress"></span></div><div id="timer-title" class="timer-title">Opening session</div><p id="timer-sub" class="muted">10 minutes allocated</p></div>
      {canModerate && <div class="timer-actions"><button class="primary" id="timer-start">Start</button><button id="timer-pause">Pause</button><button id="timer-reset">Reset</button></div>}
      {canModerate && <div class="timer-actions"><button id="phase-prev">← Phase</button><button id="phase-next">Next phase →</button></div>}
      <div class="phase-grid"><div><b>10 min</b><small>Presentation</small></div><div><b>8 min</b><small>Q&amp;A</small></div><div><b>2 min</b><small>Transition</small></div></div>
      {canModerate && <div class="timer-actions"><button id="person-prev">← Presenter</button><button id="person-next">Next presenter →</button></div>}
      <p class="hint">Timer state is saved to D1 and synchronized across signed-in devices by polling the API.</p>
    </aside>
  </div>
</main>
<footer>Symposium Management System · 13:00–15:30 WIB · Asia/Jakarta</footer>
<script define:vars={{canEdit, canModerate}}>
const $ = (id) => document.getElementById(id);
const phases = [{name:"Presentation",seconds:600},{name:"Q&A",seconds:480},{name:"Transition",seconds:120}];
let events=[], sessions=[], presenters=[], selectedEvent=null, selectedSession=null;
let timer={phaseIndex:-1,currentIndex:-1,remaining:600,duration:600,running:false,endsAt:null};
let lastRemoteUpdate="";
const esc=(v)=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt=(s)=>{s=Math.max(0,Math.floor(s));return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")};
async function api(url,options={}){const response=await fetch(url,{...options,headers:{"Content-Type":"application/json",...(options.headers||{})}});if(response.status===204)return null;const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||"Request failed");return data}
function currentRemaining(){return timer.running&&timer.endsAt?Math.max(0,Math.ceil((timer.endsAt-Date.now())/1000)):timer.remaining}
function renderTimer(){const remaining=currentRemaining();$("timer-clock").textContent=fmt(remaining);$("timer-phase").textContent=timer.phaseIndex<0?"OPENING":timer.phaseIndex>2?"CLOSING":phases[timer.phaseIndex].name.toUpperCase();const person=presenters[timer.currentIndex];$("timer-title").textContent=person?person.presentation_title:(timer.phaseIndex>2?"Closing session":"Opening session");$("timer-sub").textContent=remaining===0&&timer.running?"Time is up":fmt(timer.duration)+" allocated";$("timer-progress").style.width=(timer.duration?Math.max(0,Math.min(100,(timer.duration-remaining)/timer.duration*100)):0)+"%"}
function renderPresenters(){
 $("presenter-count").textContent=presenters.length+" presenters";
 if(!presenters.length){$("presenter-list").innerHTML='<p class="empty">No presenters in this session yet.</p>';return}
 $("presenter-list").innerHTML=presenters.map((p,i)=>'<article class="presenter '+(i===timer.currentIndex?'active':'')+'"><div class="number">'+(i+1)+'</div><div class="presenter-info"><strong>'+esc(p.presentation_title)+'</strong><small>'+esc(p.display_name)+(p.affiliation?' · '+esc(p.affiliation):'')+'</small>'+(p.material_id?'<a class="material" target="_blank" rel="noopener" href="/api/materials/'+encodeURIComponent(p.material_id)+'">'+esc(p.material_name||"Open presentation material")+'</a>':'')+(p.presentation_url?'<a class="material" target="_blank" rel="noopener" href="'+esc(p.presentation_url)+'">Open presentation link</a>':'')+'</div><div class="item-actions"><button data-select="'+i+'" title="Load timer">Load</button>'+(canEdit?'<button data-edit="'+i+'">Edit</button><button data-up="'+i+'" title="Move up">↑</button><button data-down="'+i+'" title="Move down">↓</button><button data-delete="'+i+'" class="danger" title="Remove presenter">×</button>':'')+(canEdit?'<label class="upload">Attach PDF/PPTX<input type="file" data-upload="'+i+'" accept=".pdf,.pptx,application/pdf,application/vnd.openxmlformats-officedocument.presentationml.presentation" hidden></label><button data-link="'+i+'">Add Canva URL</button>'+(p.link_id?'<button data-unlink="'+i+'" class="danger">Remove link</button>':''):'')+'</div></article>').join("");
}
async function loadPresenters(){
 if(!selectedSession){presenters=[];renderPresenters();return}
 const result=await api("/api/presenters?session_id="+encodeURIComponent(selectedSession),{headers:{}});
 presenters=result.presenters||[];renderPresenters();renderTimer();
}
async function loadSessions(){
 if(!selectedEvent)return;
 const result=await api("/api/sessions?event_id="+encodeURIComponent(selectedEvent),{headers:{}});
 sessions=result.sessions||[];
 $("session-select").innerHTML=sessions.map(s=>'<option value="'+esc(s.id)+'">'+esc(s.title)+'</option>').join("")||'<option value="">No sessions</option>';
 selectedSession=sessions[0]?.id||null;
 await loadPresenters();await loadTimer();
}
async function loadEvents(){
 const result=await api("/api/events",{headers:{}});
 events=result.events||[];
 $("event-select").innerHTML=events.map(e=>'<option value="'+esc(e.id)+'">'+new Intl.DateTimeFormat("en-GB",{day:"2-digit",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date(e.event_date+"T00:00:00Z"))+'</option>').join("");
 if(!events.length){$("event-select").innerHTML='<option>No events</option>';return}
 selectedEvent=events[0].id;$("event-time").textContent=events[0].start_time+"–"+events[0].end_time+" WIB";$("projector-link").href="/display/"+encodeURIComponent(selectedEvent);
 await loadSessions();
}
async function saveTimer(){
 if(!selectedEvent)return;
 const state={...timer,remaining:currentRemaining(),endsAt:timer.running?timer.endsAt:null,updatedAt:Date.now()};
 try{await api("/api/events/"+encodeURIComponent(selectedEvent)+"/timer",{method:"PUT",body:JSON.stringify(state)});$("sync-status").textContent="Synced";}catch(e){$("sync-status").textContent="Sync error";console.error(e)}
}
async function loadTimer(){
 if(!selectedEvent)return;
 try{
  const result=await api("/api/events/"+encodeURIComponent(selectedEvent)+"/timer",{headers:{}});
  if(result.state){timer={...timer,...result.state};lastRemoteUpdate=result.updated_at||""}
  else timer={phaseIndex:-1,currentIndex:-1,remaining:600,duration:600,running:false,endsAt:null};
  renderTimer();$("sync-status").textContent="Synced";
 }catch(e){$("sync-status").textContent="Unavailable"}
}
function setPhase(index){timer.running=false;timer.phaseIndex=Math.max(-1,Math.min(3,index));timer.duration=index<0?600:index>2?1200:phases[index].seconds;timer.remaining=timer.duration;timer.endsAt=null;renderTimer();saveTimer()}
function selectPresenter(index){if(!presenters.length)return;timer.currentIndex=Math.max(0,Math.min(presenters.length-1,index));setPhase(0)}
$("event-select").addEventListener("change",async e=>{selectedEvent=e.target.value;const event=events.find(x=>x.id===selectedEvent);$("event-time").textContent=event?event.start_time+"–"+event.end_time+" WIB":"";$("projector-link").href="/display/"+encodeURIComponent(selectedEvent);await loadSessions()});
$("session-select").addEventListener("change",async e=>{selectedSession=e.target.value;await loadPresenters();timer.currentIndex=-1;await loadTimer()});
$("presenter-list").addEventListener("click",async e=>{
 const b=e.target.closest("button");if(!b)return;const i=Number(b.dataset.select??b.dataset.up??b.dataset.down??b.dataset.delete??b.dataset.link??b.dataset.unlink??b.dataset.edit);if(!Number.isInteger(i))return;
 if(b.dataset.select!==undefined){selectPresenter(i);return}
 if(b.dataset.edit!==undefined){const p=presenters[i];const display_name=prompt("Presenter name:",p.display_name);if(display_name===null)return;const presentation_title=prompt("Presentation title:",p.presentation_title);if(presentation_title===null)return;const affiliation=prompt("Affiliation:",p.affiliation||"");if(affiliation===null)return;try{await api("/api/presenters/"+encodeURIComponent(p.id),{method:"PATCH",body:JSON.stringify({display_name,presentation_title,affiliation,sort_order:p.sort_order||i+1})});await loadPresenters()}catch(err){alert(err.message)}return}\n if(b.dataset.link!==undefined){const url=prompt("Paste the Canva or presentation HTTPS URL:");if(!url)return;try{await api("/api/links",{method:"POST",body:JSON.stringify({presenter_id:presenters[i].id,url,label:"Canva presentation"})});await loadPresenters()}catch(err){alert(err.message)}return}
 if(b.dataset.unlink!==undefined){if(!confirm("Remove this presentation link?"))return;try{await api("/api/links/"+encodeURIComponent(presenters[i].link_id),{method:"DELETE"});await loadPresenters()}catch(err){alert(err.message)}return}
 if(b.dataset.delete!==undefined){if(!confirm("Remove this presenter?"))return;try{await api("/api/presenters/"+encodeURIComponent(presenters[i].id),{method:"DELETE"});await loadPresenters()}catch(err){alert(err.message)}return}
 if(b.dataset.up!==undefined||b.dataset.down!==undefined){
  const j=b.dataset.up!==undefined?i-1:i+1;if(j<0||j>=presenters.length)return;
  const reordered=[...presenters];[reordered[i],reordered[j]]=[reordered[j],reordered[i]];
  try{for(let k=0;k<reordered.length;k++){const p=reordered[k];await api("/api/presenters/"+encodeURIComponent(p.id),{method:"PATCH",body:JSON.stringify({display_name:p.display_name,affiliation:p.affiliation,presentation_title:p.presentation_title,sort_order:k+1})})}await loadPresenters()}catch(err){alert(err.message)}
 }
});
$("presenter-list").addEventListener("change",async e=>{
 const input=e.target.closest("input[data-upload]");if(!input||!input.files?.[0])return;
 const form=new FormData();form.append("presenter_id",presenters[Number(input.dataset.upload)].id);form.append("file",input.files[0]);form.append("visibility","event");
 try{const response=await fetch("/api/materials",{method:"POST",body:form});const data=await response.json();if(!response.ok)throw new Error(data.error||"Upload failed");await loadPresenters()}catch(err){alert(err.message)}finally{input.value=""}
});
if(canEdit)$("presenter-form").addEventListener("submit",async e=>{
 e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget));data.session_id=selectedSession;data.sort_order=presenters.length+1;
 try{await api("/api/presenters",{method:"POST",body:JSON.stringify(data)});e.currentTarget.reset();$("form-message").textContent="Presenter added.";await loadPresenters()}catch(err){$("form-message").textContent=err.message}
});
if(canModerate){
 $("timer-start").onclick=()=>{if(timer.running)return;timer.remaining=currentRemaining();timer.endsAt=Date.now()+timer.remaining*1000;timer.running=true;renderTimer();saveTimer()};
 $("timer-pause").onclick=()=>{timer.remaining=currentRemaining();timer.running=false;timer.endsAt=null;renderTimer();saveTimer()};
 $("timer-reset").onclick=()=>{timer.running=false;timer.endsAt=null;timer.remaining=timer.duration;renderTimer();saveTimer()};
 $("phase-next").onclick=()=>setPhase(timer.phaseIndex+1);$("phase-prev").onclick=()=>setPhase(timer.phaseIndex-1);
 $("person-next").onclick=()=>selectPresenter(timer.currentIndex+1);$("person-prev").onclick=()=>selectPresenter(timer.currentIndex-1);
}
$("logout").onclick=async()=>{await fetch("/api/auth/logout",{method:"POST"});location.href="/"};
await loadEvents();
setInterval(()=>{if(timer.running&&currentRemaining()===0){timer.running=false;timer.remaining=0;timer.endsAt=null;saveTimer()}renderTimer()},250);
setInterval(async()=>{if(!selectedEvent)return;try{const result=await api("/api/events/"+encodeURIComponent(selectedEvent)+"/timer",{headers:{}});if(result.updated_at&&result.updated_at!==lastRemoteUpdate){lastRemoteUpdate=result.updated_at;timer={...timer,...result.state};renderTimer()}}catch{}},2000);
</script>
<style>
:root{color-scheme:dark;--bg:#0b1120;--panel:#131e30;--line:#27364d;--muted:#9aabc2;--text:#eef4fb;--accent:#53c7a5}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,sans-serif}.topbar{display:flex;align-items:center;gap:14px;padding:17px max(22px,calc((100% - 1180px)/2));border-bottom:1px solid #ffffff12}.brand{font-weight:900;font-size:20px;color:var(--accent);text-decoration:none}.brand span{color:white}.identity{flex:1}.identity strong,.identity small{display:block}.identity strong{font-size:13px}.identity small{color:var(--muted);font-size:11px;text-transform:capitalize}.quiet,button{background:#1b2940;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px 11px;cursor:pointer;font:inherit}.quiet{font-size:12px}main{max-width:1180px;margin:34px auto 70px;padding:0 22px}.page-heading,.section-head{display:flex;justify-content:space-between;align-items:center;gap:14px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.8px;color:var(--accent);margin:0 0 5px}.page-heading h1{font-size:30px;letter-spacing:-1px;margin:0}.live,.sync{font-size:11px;color:var(--muted)}.live i{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-right:6px}.heading-actions{display:flex;align-items:center;gap:14px}.projector-link{font-size:11px;color:var(--accent);border:1px solid var(--line);padding:7px 10px;border-radius:8px;text-decoration:none}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px}.toolbar{display:flex;align-items:end;gap:14px;margin:24px 0}.toolbar label,.form-grid label{display:grid;gap:5px;color:var(--muted);font-size:11px}.toolbar select,.form-grid input{background:#0b1423;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:10px;min-width:210px}.toolbar .muted{margin-left:auto;font-size:12px}.columns{display:grid;grid-template-columns:1.2fr .8fr;gap:17px}.section-head{margin-bottom:14px}.section-head h2{font-size:16px;margin:0}.muted{color:var(--muted)}.presenter{display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:11px;padding:13px 0;border-top:1px solid var(--line);align-items:start}.number{width:28px;height:28px;display:grid;place-items:center;background:#20334a;color:var(--accent);border-radius:8px;font-weight:800}.presenter.active .number{background:var(--accent);color:#09251e}.presenter-info strong,.presenter-info small{display:block}.presenter-info strong{font-size:13px}.presenter-info small{font-size:11px;color:var(--muted);margin-top:3px}.material{display:inline-block;color:var(--accent);font-size:11px;margin:5px 10px 0 0}.item-actions{display:flex;flex-wrap:wrap;justify-content:end;gap:5px}.item-actions button{font-size:10px;padding:5px 7px}.danger{color:#ffaaa8}.upload{font-size:10px;color:var(--accent);border:1px solid var(--line);border-radius:7px;padding:5px 7px;cursor:pointer}.empty{padding:20px 0;color:var(--muted)}.add-form{border-top:1px solid var(--line);margin-top:18px;padding-top:16px}.add-form h3{font-size:13px;margin:0 0 12px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid .wide{grid-column:1/-1}.form-grid input{width:100%;min-width:0}.primary{background:var(--accent);color:#08251e;border:0;font-weight:750}.add-form>button{margin-top:12px}.add-form>p{font-size:11px}.timer-panel{align-self:start}.timer-face{text-align:center;padding:18px 4px}.phase{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:1.5px}.clock{font-size:clamp(54px,7vw,78px);font-weight:800;letter-spacing:-3px;font-variant-numeric:tabular-nums;line-height:1.3;margin:8px 0}.progress{height:6px;border-radius:10px;background:#27364d;overflow:hidden}.progress span{display:block;height:100%;background:var(--accent);width:0%}.timer-title{font-size:15px;font-weight:700;margin-top:14px}.timer-face p{font-size:11px}.timer-actions{display:flex;justify-content:center;gap:8px;margin:12px 0}.timer-actions button{font-size:11px}.phase-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:18px 0}.phase-grid div{background:#0b1423;border:1px solid var(--line);border-radius:9px;padding:10px;text-align:center}.phase-grid b,.phase-grid small{display:block}.phase-grid b{font-size:16px}.phase-grid small{font-size:10px;color:var(--muted)}.hint{font-size:10px;color:var(--muted);text-align:center;margin:18px 5px 2px}footer{text-align:center;border-top:1px solid #ffffff12;padding:20px;color:var(--muted);font-size:10px}@media(max-width:850px){.columns{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-direction:column}.toolbar label{display:flex;justify-content:space-between;align-items:center}.toolbar select{min-width:0;flex:1}.toolbar .muted{margin-left:0}.presenter{grid-template-columns:28px minmax(0,1fr)}.item-actions{grid-column:2;justify-content:start}}@media(max-width:540px){main{margin-top:24px}.page-heading{align-items:start;flex-direction:column}.heading-actions{flex-wrap:wrap}.form-grid{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}.topbar{padding:14px 18px}}
</style>
</body></html>