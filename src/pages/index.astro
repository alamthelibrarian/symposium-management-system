---
export const prerender = false;
const appName = Astro.locals.runtime.env.APP_NAME || "Symposium Management System";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#111827" />
    <title>{appName}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Symposium Management System">SMS<span>.</span></a>
      <div><strong>{appName}</strong><small>Presentation schedule · Materials · Session control</small></div>
      <a class="login" href="/login">Sign in</a>
    </header>
    <main>
      <section class="intro">
        <p class="eyebrow">SYMPOSIUM OPERATIONS</p>
        <h1>Keep every session<br /><span>on schedule.</span></h1>
        <p class="lead">A focused workspace for organizing presentation sequences, managing materials, and running symposium sessions.</p>
        <div class="actions"><a class="button primary" href="/login">Open workspace</a><a class="button" href="#events">View schedule dates</a></div>
      </section>
      <section id="events" class="events">
        <div class="section-heading"><div><p class="eyebrow">SCHEDULE</p><h2>Upcoming symposium dates</h2></div><span id="event-count">Loading dates…</span></div>
        <div id="event-list" class="event-grid"><div class="event-card skeleton"></div><div class="event-card skeleton"></div><div class="event-card skeleton"></div></div>
      </section>
    </main>
    <footer>Symposium Management System <span>·</span> Built for session operations</footer>
    <script>
      const list = document.querySelector("#event-list");
      const count = document.querySelector("#event-count");
      const dateLabel = (value) => new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(value + "T00:00:00Z"));
      fetch("/api/events").then((response) => { if (!response.ok) throw new Error("Schedule unavailable"); return response.json(); })
        .then(({ events }) => {
          count.textContent = events.length + " scheduled dates";
          list.innerHTML = events.map((event) => `<article class="event-card"><div class="event-date">${dateLabel(event.event_date)}</div><h3>${event.title}</h3><p>${event.start_time}–${event.end_time} WIB</p><span class="status">${event.status}</span></article>`).join("") || "<p>No dates have been scheduled.</p>";
        })
        .catch(() => { count.textContent = "Schedule unavailable"; list.innerHTML = "<p>Connect and initialize the D1 database to display event dates.</p>"; });
    </script>
    <style>
      :root{color-scheme:dark;--bg:#0b1120;--panel:#131e30;--line:#27364d;--muted:#9aabc2;--text:#eef4fb;--accent:#53c7a5}
      *{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 75% 0%,#163044 0,transparent 38%),var(--bg);color:var(--text);font:15px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}
      a{color:inherit;text-decoration:none}.topbar{max-width:1160px;margin:auto;padding:24px 24px;display:flex;align-items:center;gap:14px;border-bottom:1px solid #ffffff12}.brand{font-size:20px;font-weight:850;letter-spacing:-1px;color:var(--accent)}.brand span{color:#fff}.topbar strong,.topbar small{display:block}.topbar strong{font-size:13px}.topbar small{font-size:11px;color:var(--muted)}.login{margin-left:auto;border:1px solid var(--line);padding:8px 15px;border-radius:8px;font-size:13px}
      main{max-width:1160px;margin:auto;padding:72px 24px 90px}.intro{max-width:720px}.eyebrow{color:var(--accent);font-size:11px;font-weight:750;letter-spacing:2px}.intro h1{font-size:clamp(42px,7vw,76px);line-height:1.02;letter-spacing:-3px;margin:18px 0}.intro h1 span{color:var(--accent)}.lead{max-width:570px;color:var(--muted);font-size:17px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.button{border:1px solid var(--line);padding:11px 17px;border-radius:9px;font-size:13px;font-weight:650}.button.primary{background:var(--accent);color:#08251e;border-color:var(--accent)}
      .events{margin-top:90px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px}.section-heading h2{font-size:23px;margin:3px 0}.section-heading>span{font-size:12px;color:var(--muted)}.event-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}.event-card{background:linear-gradient(145deg,#17243a,#111a2a);border:1px solid var(--line);border-radius:14px;padding:22px;min-height:150px}.event-date{font-size:12px;color:var(--accent);font-weight:700}.event-card h3{font-size:17px;margin:14px 0 4px}.event-card p{font-size:12px;color:var(--muted);margin:0}.status{display:inline-block;margin-top:13px;border:1px solid var(--line);border-radius:20px;padding:2px 9px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1px}.skeleton{opacity:.5;min-height:150px}
      footer{border-top:1px solid #ffffff12;padding:22px 24px;text-align:center;color:var(--muted);font-size:11px}footer span{color:var(--accent)}@media(max-width:700px){main{padding-top:52px}.event-grid{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column}.intro h1{letter-spacing:-2px}}
    </style>
  </body>
</html>